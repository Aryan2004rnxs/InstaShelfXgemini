# Google Cloud Infrastructure Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_credentials.json

# Google Gemini API & ADK Configuration
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=some_random_secure_string_for_webhook_security
ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_POLLING=false

# Apify Token for Instagram Scraping
APIFY_API_TOKEN=your_apify_api_token_here

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API Key (Secondary Optimization Layer)
GROQ_API_KEY=your_groq_api_key_from_groq_console

# Google Sheets Configuration
GOOGLE_CREDS_JSON=your_base64_encoded_service_account_json
GOOGLE_SHEET_ID=your_google_sheet_id_from_url

# PostgreSQL / Supabase Database URL (Optional - defaults to local SQLite)
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Host & Logging Configuration
HF_SPACE_URL=https://your-app-domain.run.app
LOG_LEVEL=INFO
